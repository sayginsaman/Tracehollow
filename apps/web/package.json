{
  "name": "@tracehollow/web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
