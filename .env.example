# Tracehollow local configuration (non-secret values only).
#
# scripts/setup.sh copies this file to .env. Secrets are NOT configured here: they are
# generated into secrets/ and mounted into containers as files.

# --- Published ports -------------------------------------------------------------------
# Both services bind to loopback by default. Binding to another address exposes the login
# page and API to your network; only do so behind TLS and after updating the origin and
# host settings below.
TRACEHOLLOW_WEB_BIND_ADDRESS=127.0.0.1
TRACEHOLLOW_WEB_PORT=3000
TRACEHOLLOW_API_BIND_ADDRESS=127.0.0.1
TRACEHOLLOW_API_PORT=8000

# --- Browser origin and host protection --------------------------------------------------
# Defaults are derived from TRACEHOLLOW_WEB_PORT. Uncomment to override.
# TRACEHOLLOW_PUBLIC_ORIGIN=http://localhost:3000
# TRACEHOLLOW_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRACEHOLLOW_API_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api
# TRACEHOLLOW_WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Sessions ----------------------------------------------------------------------------
TRACEHOLLOW_SESSION_IDLE_TIMEOUT_MINUTES=480
TRACEHOLLOW_SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# --- Diagnostics -------------------------------------------------------------------------
TRACEHOLLOW_LOG_LEVEL=INFO
# Interactive API docs load Swagger UI assets from a public CDN when enabled.
TRACEHOLLOW_API_DOCS_ENABLED=false
