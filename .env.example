# Tracehollow local configuration (non-secret values only).
#
# scripts/setup.sh copies this file to .env. Secrets are NOT configured here: they are
# generated into secrets/ and mounted into containers as files.

# --- Published ports -------------------------------------------------------------------
# Both services bind to loopback by default. Binding to another address exposes the login
# page and API to your network; only do so behind TLS and after updating the origin and
# host settings below.
TRACEHOLLOW_WEB_BIND_ADDRESS=127.0.0.1
TRACEHOLLOW_WEB_PORT=3000
TRACEHOLLOW_API_BIND_ADDRESS=127.0.0.1
TRACEHOLLOW_API_PORT=8000

# --- Browser origin and host protection --------------------------------------------------
# Defaults are derived from TRACEHOLLOW_WEB_PORT. Uncomment to override.
# TRACEHOLLOW_PUBLIC_ORIGIN=http://localhost:3000
# TRACEHOLLOW_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# TRACEHOLLOW_API_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api
# TRACEHOLLOW_WEB_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Sessions ----------------------------------------------------------------------------
TRACEHOLLOW_SESSION_IDLE_TIMEOUT_MINUTES=480
TRACEHOLLOW_SESSION_ABSOLUTE_TIMEOUT_HOURS=24

# --- Diagnostics -------------------------------------------------------------------------
TRACEHOLLOW_LOG_LEVEL=INFO
# Interactive API docs load Swagger UI assets from a public CDN when enabled.
TRACEHOLLOW_API_DOCS_ENABLED=false

# --- Evidence-grounded AI (docs/operations/ai-models.md) -------------------------------
# The workspace starts and works without any model. Set to false to turn off every AI feature.
TRACEHOLLOW_AI_ENABLED=true
# ollama: local models via Ollama. synthetic_fixture: deterministic, labelled test stand-in.
TRACEHOLLOW_AI_LOCAL_PROVIDER=ollama
# Operator-configured model endpoint (Ollama on this machine by default).
TRACEHOLLOW_AI_OLLAMA_BASE_URL=http://host.docker.internal:11434
TRACEHOLLOW_AI_GENERATION_MODEL=qwen3:8b
TRACEHOLLOW_AI_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Optional cloud generation. Also put the API key into secrets/cloud_ai_api_key. Cases are
# local-only until an analyst explicitly allows cloud processing for that case.
TRACEHOLLOW_AI_CLOUD_PROVIDER=none
TRACEHOLLOW_AI_CLOUD_MODEL=claude-sonnet-5

# --- Public-source collection (docs/connectors/README.md) -------------------------------------
# Collection destinations are checked against SSRF rules: loopback, private, link-local and
# metadata addresses are refused. List private networks here ONLY for lab targets you control;
# loopback and link-local stay blocked regardless. Example: 10.20.0.0/16
TRACEHOLLOW_COLLECTION_ALLOWED_PRIVATE_NETWORKS=
TRACEHOLLOW_COLLECTION_ALLOWED_PORTS=80,443
# GitHub.com by default; GitHub Enterprise Server uses https://HOST/api/v3.
TRACEHOLLOW_GITHUB_API_BASE_URL=https://api.github.com
